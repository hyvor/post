{
	frankenphp {
        worker "/app/backend/public/index.php" {$WORKERS:0}
    }
}

{$ARCHIVE_HOST}:80, *.{$ARCHIVE_HOST}:80 {
	reverse_proxy 127.0.0.1:3000
}

# marketing pages moved to hyvor.com/post
(marketing_redirects) {
	# ?query of the request, to be appended to the redirect URL
	@has_query expression {query} != ""
	vars @has_query query_suffix ?{query}

	# homepage and marketing pages
	# / -> https://hyvor.com/post, /pricing -> https://hyvor.com/post/pricing, etc.
	@marketing path_regexp marketing ^(/pricing|/terms|/privacy)?/?$
	redir @marketing https://hyvor.com/post{re.marketing.1}{vars.query_suffix} 301

	# docs and self-hosting docs, now rendered at hyvor.com/post/docs and /post/hosting
	# also handles the language prefix (/fr/docs -> https://hyvor.com/post/fr/docs)
	@docs path_regexp docs ^((?:/fr)?)/(docs|hosting)((?:/[^/]+)*)/?$
	redir @docs https://hyvor.com/post{re.docs.1}/{re.docs.2}{re.docs.3}{vars.query_suffix} 301
}

{$CADDY_ADDRESS} {

	import marketing_redirects

    {$CADDY_TLS_CONFIG}

	# form
	handle /form/*.js {
		root * /app/static
		file_server
		encode zstd gzip
		header Content-Type text/javascript
        header Cache-Control "max-age=60"
        header Access-Control-Allow-Origin "*"
	}

	# backend
	@backend {
		path /api/*
	}
	handle @backend {
		root * /app/backend/public
		php_server {
		   file_server off
           try_files index.php
        }
    }

	# static pages
	handle {
		root * /app/static
		file_server
		encode zstd gzip
		try_files {path} {path}.html
	}

	# dynamic
	@dynamic {
		path /console*
		path /sudo*
	}
	handle @dynamic {
		root * /app/static
		encode zstd gzip
		file_server
		rewrite * /fallback.html
	}

	# 404 page is still fallback.html
	handle_errors {
		root * /app/static
        rewrite * /fallback.html
        header Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        file_server
    }
}